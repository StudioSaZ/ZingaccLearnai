class DashboardScreen extends StatelessWidget {
  const DashboardScreen({
    super.key,
    required this.selectedLevel,
    required this.selectedMedium,
    required this.selectedSubject,
    required this.language,
  });

  final String selectedLevel;

  final String selectedMedium;

  final String selectedSubject;

  final String language;

  bool get _isSinhala =>
      language == 'සිංහල' || language.toLowerCase() == 'sinhala';

  bool get _isTamil => language == 'தமிழ்' || language.toLowerCase() == 'tamil';

  String _t(String sinhala, String english, String tamil) {
    if (_isSinhala) return sinhala;

    if (_isTamil) return tamil;

    return english;
  }

  String get _levelName {
    switch (selectedLevel) {
      case 'grade_5_scholarship':
        return _t('5 ශ්‍රේණිය ශිෂ්‍යත්වය', 'Grade 5 Scholarship',
            'தரம் 5 புலமைப்பரிசில்');

      case 'grade_6':
        return _t('6 ශ්‍රේණිය', 'Grade 6', 'தரம் 6');

      case 'grade_7':
        return _t('7 ශ්‍රේණිය', 'Grade 7', 'தரம் 7');

      case 'grade_8':
        return _t('8 ශ්‍රේණිය', 'Grade 8', 'தரம் 8');

      case 'grade_9':
        return _t('9 ශ්‍රේණිය', 'Grade 9', 'தரம் 9');

      case 'ol':
        return _t('සාමාන්‍ය පෙළ', 'O/L', 'சாதாரண தரம்');

      case 'al':
        return _t('උසස් පෙළ', 'A/L', 'உயர் தரம்');

      default:
        return _titleCase(selectedLevel.replaceAll('_', ' '));
    }
  }

  String get _mediumName {
    switch (selectedMedium) {
      case 'sinhala':
        return _t('සිංහල මාධ්‍යය', 'Sinhala Medium', 'சிங்கள மொழிமூலம்');

      case 'english':
        return _t('ඉංග්‍රීසි මාධ්‍යය', 'English Medium', 'ஆங்கில மொழிமூலம்');

      case 'tamil':
        return _t('දෙමළ මාධ්‍යය', 'Tamil Medium', 'தமிழ் மொழிமூலம்');

      default:
        return _titleCase(selectedMedium.replaceAll('_', ' '));
    }
  }

  String get _subjectName {
    switch (selectedSubject) {
      case 'mathematics':
      case 'maths':
        return _t('ගණිතය', 'Mathematics', 'கணிதம்');

      case 'science':
        return _t('විද්‍යාව', 'Science', 'விஞ்ஞானம்');

      case 'english':
        return _t('ඉංග්‍රීසි', 'English', 'ஆங்கிலம்');

      case 'sinhala':
        return _t('සිංහල', 'Sinhala', 'சிங்களம்');

      case 'tamil':
        return _t('දෙමළ', 'Tamil', 'தமிழ்');

      case 'history':
        return _t('ඉතිහාසය', 'History', 'வரலாறு');

      case 'geography':
        return _t('භූගෝල විද්‍යාව', 'Geography', 'புவியியல்');

      case 'ict':
        return _t('තොරතුරු හා සන්නිවේදන තාක්ෂණය', 'ICT',
            'தகவல் தொடர்பாடல் தொழில்நுட்பம்');

      case 'civics':
      case 'civic_education':
        return _t('පුරවැසි අධ්‍යාපනය', 'Civic Education', 'குடியியல் கல்வி');

      case 'health':
      case 'health_pe':
        return _t('සෞඛ්‍ය හා ශාරීරික අධ්‍යාපනය', 'Health & Physical Education',
            'சுகாதாரம் மற்றும் உடற்கல்வி');

      case 'art':
        return _t('චිත්‍ර කලාව', 'Art', 'சித்திரம்');

      case 'music':
        return _t('සංගීතය', 'Music', 'இசை');

      case 'dancing':
        return _t('නර්තනය', 'Dancing', 'நடனம்');

      case 'drama':
        return _t(
            'නාට්‍ය හා රංග කලාව', 'Drama & Theatre', 'நாடகமும் அரங்கியலும்');

      case 'buddhism':
        return _t('බුද්ධ ධර්මය', 'Buddhism', 'பௌத்தம்');

      case 'hinduism':
        return _t('හින්දු ධර්මය', 'Hinduism', 'இந்து சமயம்');

      case 'christianity':
        return _t('ක්‍රිස්තියානි ධර්මය', 'Christianity', 'கிறிஸ்தவம்');

      case 'catholicism':
        return _t('කතෝලික ධර්මය', 'Catholicism', 'கத்தோலிக்கம்');

      case 'islam':
        return _t('ඉස්ලාම් ධර්මය', 'Islam', 'இஸ்லாம்');

      case 'commerce':
        return _t('වාණිජ්‍යය', 'Commerce', 'வணிகம்');

      case 'media':
        return _t('මාධ්‍ය අධ්‍යයනය', 'Media', 'ஊடகக் கல்வி');

      default:
        return _titleCase(selectedSubject.replaceAll('_', ' '));
    }
  }

  String _titleCase(String value) {
    if (value.isEmpty) return value;

    return value
        .split(' ')
        .map(
          (word) => word.isEmpty
          ? word
          : '${word[0].toUpperCase()}${word.substring(1)}',
    )
        .join(' ');
  }

  Future<void> _logout(BuildContext context) async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text(_t('ඉවත් වන්නද?', 'Log out?', 'வெளியேற வேண்டுமா?')),
        content: Text(_t(
          'ඔබගේ ගිණුමෙන් ඉවත් වීමට අවශ්‍යද?',
          'Do you want to sign out of your account?',
          'உங்கள் கணக்கிலிருந்து வெளியேற விரும்புகிறீர்களா?',
        )),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: Text(_t('අවලංගු කරන්න', 'Cancel', 'ரத்து செய்')),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: Text(_t('ඉවත් වන්න', 'Log out', 'வெளியேறு')),
          ),
        ],
      ),
    );
    if (confirmed != true || !context.mounted) return;
    try {
      await FirebaseAuth.instance.signOut();
      if (!context.mounted) return;
      Navigator.of(context).pushAndRemoveUntil(
        MaterialPageRoute<void>(builder: (_) => const LoginScreen()),
            (route) => false,
      );
    } catch (error) {
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
            content: Text(_t(
              'ඉවත් වීමට නොහැකි වුණා. නැවත උත්සාහ කරන්න.',
              'Could not log out. Please try again.',
              'வெளியேற முடியவில்லை. மீண்டும் முயற்சிக்கவும்.',
            ))),
      );
    }
  }

  void _openAITutor(BuildContext context) {
    Navigator.push(
      context,
      MaterialPageRoute<void>(
        builder: (context) => AITutorScreen(
          selectedLevel: selectedLevel,
          selectedMedium: selectedMedium,
          selectedSubject: selectedSubject,
          language: language,
        ),
      ),
    );
  }

  void _openFormulaLibrary(BuildContext context) {
    Navigator.push(
      context,
      MaterialPageRoute<void>(
        builder: (context) => FormulaLibraryScreen(
          selectedLevel: selectedLevel,
          selectedSubject: selectedSubject,
          language: language,
        ),
      ),
    );
  }

  void _openScholarshipPractice(BuildContext context) {
    Navigator.push(
        context,
        MaterialPageRoute<void>(
          builder: (context) => ScholarshipPracticeScreen(language: language),
        ));
  }

