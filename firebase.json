{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "zingacc-learn-ai",
          "appId": "1:206138519919:android:0ca0dc4ba36c74393bf89a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "zingacc-learn-ai",
          "configurations": {
            "android": "1:206138519919:android:0ca0dc4ba36c74393bf89a",
            "ios": "1:206138519919:ios:d8ae801daa65fe7f3bf89a",
            "web": "1:206138519919:web:705e0bbc80de3a383bf89a"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
